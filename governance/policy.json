{
  "version": 1,
  "approver": "user",
  "scope": {
    "_note": "Only targets you own or test with written permission. Only the user edits this list.",
    "allowed_targets": ["localhost", "127.0.0.1", "::1"]
  },
  "active_scanners": [
    "nmap", "masscan", "zmap", "nikto", "nuclei", "nc", "ncat", "netcat",
    "test-netconnection", "tnc", "hping3", "gobuster", "ffuf", "dirb",
    "nessus", "openvas", "openvas-cli", "gvm", "gvm-cli", "qualys",
    "zap", "zap-cli", "wpscan", "sslyze", "testssl"
  ],
  "diagnostic_tools": ["ping", "tracert", "traceroute", "pathping", "mtr"],
  "http_clients": ["curl", "wget", "invoke-webrequest", "iwr", "invoke-restmethod", "irm"],
  "forbidden_tools": [
    "hydra", "medusa", "sqlmap", "msfconsole", "msfvenom", "mimikatz", "john", "hashcat",
    "responder", "crackmapexec", "netexec", "nxc", "impacket", "evil-winrm", "beef"
  ],
  "destructive_patterns": [
    "\\brm\\s+-[a-z]*r[a-z]*f", "\\brm\\s+-[a-z]*f[a-z]*r", "remove-item\\b.*-recurse",
    "\\bformat\\s+[a-z]:", "\\bdel\\s+/s", "\\brd\\s+/s", "\\brmdir\\s+/s",
    "git\\s+push\\b.*--force", "git\\s+reset\\s+--hard", "\\bstop-process\\b", "\\btaskkill\\b",
    "\\bshutdown\\b", "\\breg\\s+(delete|add)\\b", "set-executionpolicy", "netsh\\s+advfirewall",
    "set-mppreference", "\\bschtasks\\s+/create", "new-service", "\\bsc\\s+(create|delete|config)\\b"
  ],
  "sensitive_patterns": [
    "(^|/)\\.env(\\.|$)", "id_rsa", "id_ed25519", "\\.pem$", "\\.key$", "\\.kdbx$", "\\.pfx$",
    "credentials", "(^|/)secrets?(\\.|/|$)", "sam$", "ntds\\.dit"
  ],
  "paths": {
    "_note": "'@key' values resolve to paths in governance/paths.json; protection moves with the folder. .claude/ and claude.md locations are fixed by Claude Code.",
    "deny_write": ["@approved", "@audit_log", "@audit_archive", "@evidence"],
    "ask_write": ["@paths_file", "@governance", ".claude/", "claude.md", "@tools"]
  },
  "deny_commands": ["@approve_script", "@activate_script"],
  "evidence_guard": {
    "_note": "Every shell command (main session included) that names the evidence folder or a .kanit file runs only with these tools, in every part of the chain, without redirection or substitution. Evidence is never executed.",
    "dirs": ["@evidence"],
    "markers": ["\\.kanit\\b"],
    "allowed": ["sha256sum", "sha1sum", "md5sum", "get-filehash", "wc", "grep", "ls", "stat"]
  },
  "agent_shell": {
    "_note": "These agents' shell runs only the listed tools (matched by agent_type in hook data). Unlisted agents are not restricted.",
    "incident-responder": ["sha256sum", "sha1sum", "md5sum", "get-filehash", "wc", "grep", "ls", "stat"]
  },
  "restricted_syntax": ["$(", "`", "<(", ">(", ">", "<"]
}
